{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application metadata",
  "description": "Portable public application identity. Installation destinations, credentials and environment bindings belong in installation records. This metadata does not authorize runtime permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "entry"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "display_name": {
      "type": "string",
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "description": "Semantic Version, for example 1.0.0 or 1.0.0-beta.1"
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "author": {
      "type": "string",
      "maxLength": 256
    },
    "license": {
      "type": "string",
      "maxLength": 128
    },
    "homepage": {
      "type": "string",
      "maxLength": 2048
    },
    "repository": {
      "type": "string",
      "maxLength": 2048
    },
    "keywords": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "icon": {
      "type": "string",
      "description": "Relative asset path inside the application"
    },
    "entry": {
      "type": "string",
      "description": "Relative TOML component entry, normally component.toml"
    }
  }
}
