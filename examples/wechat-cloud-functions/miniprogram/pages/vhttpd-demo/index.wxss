page { background: #14110f; color: #f4eee6; }
.demo { padding: 40rpx 30rpx 70rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 3rpx; color: #cbaa80; }
.title { font-size: 40rpx; font-weight: 600; margin: 18rpx 0; }
.subtitle, .footer { font-size: 24rpx; color: #b6a99b; line-height: 1.7; }
.notice { margin: 26rpx 0; padding: 24rpx; border: 1rpx solid #80664a; border-radius: 16rpx; color: #e5c89f; font-size: 25rpx; line-height: 1.7; }
.card { background: #211c18; border-radius: 20rpx; padding: 28rpx; margin: 24rpx 0; }
.label { font-size: 27rpx; margin-bottom: 20rpx; }
input { background: #14110f; padding: 18rpx; border-radius: 10rpx; font-size: 25rpx; }
button { margin-top: 20rpx; background: #dfc09a; color: #21170e; font-size: 27rpx; }
button[disabled] { background: #4c4136; color: #9f9181; }
.secondary { background: #38302a; color: #e7d5bf; }
.status { margin-top: 22rpx; font-size: 27rpx; }
.error { color: #ffb3a8; margin-top: 20rpx; word-break: break-all; }
.trace { font-size: 21rpx; color: #b6a99b; margin-top: 22rpx; word-break: break-all; }
.result { display: block; white-space: pre-wrap; word-break: break-all; font-size: 23rpx; line-height: 1.6; padding-top: 18rpx; }
.event { color: #cbaa80; font-size: 24rpx; margin-top: 14rpx; }
