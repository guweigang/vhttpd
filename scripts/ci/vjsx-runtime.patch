diff --git a/runtime_asset_gzip.c.v b/runtime_asset_gzip.c.v
new file mode 100644
--- /dev/null
+++ b/runtime_asset_gzip.c.v
@@ -0,0 +1,56 @@
+module vjsx
+
+import compress.deflate
+import encoding.binary
+import v.embed_file
+import log
+import time
+
+// Use the native DEFLATE decoder already shipped with V. Embedded compiler
+// assets are large: interpreting every match through the V decoder on each
+// lane can exhaust the host's initialization deadline in unoptimized builds.
+#flag -I @VEXEROOT/thirdparty/zip
+#flag -I @VMODROOT
+#include "runtime_asset_gzip.h"
+
+fn C.vjsx_inflate_embedded_asset(input voidptr, input_size usize, output voidptr, output_capacity usize, output_size &usize) i32
+
+fn C.vjsx_embedded_asset_crc32(bytes voidptr, size usize) u32
+
+fn runtime_embedded_gzip_asset_source(asset &embed_file.EmbedFileData) !string {
+	started := time.sys_mono_now()
+	log.debug('[vjsx] embedded gzip decode begin')
+	source := decode_embedded_gzip_asset(asset.to_bytes())!
+	elapsed_ms := (time.sys_mono_now() - started) / 1_000_000
+	log.debug('[vjsx] embedded gzip decode done bytes=${source.len} elapsed_ms=${elapsed_ms}')
+	return source
+}
+
+// This decoder is only for trusted, single-member, build-time embedded assets.
+// External asset overrides still follow the normal filesystem/source loader.
+fn decode_embedded_gzip_asset(bytes []u8) !string {
+	header := deflate.validate_gzip_header(bytes)!
+	trailer := bytes.len - 8
+	payload := bytes[header.payload_start..trailer]
+	expected_crc := binary.little_endian_u32_at(bytes, trailer)
+	expected_size := binary.little_endian_u32_at(bytes, trailer + 4)
+
+	if u64(expected_size) > u64(0x7fffffff) {
+		return error('invalid embedded gzip asset: size exceeds supported limit')
+	}
+	mut data := []u8{len: if expected_size == 0 { 1 } else { int(expected_size) }}
+	mut decoded_len := usize(0)
+	if C.vjsx_inflate_embedded_asset(payload.data, usize(payload.len), data.data,
+		usize(data.len), &decoded_len) != 1 {
+		return error('invalid embedded gzip asset: DEFLATE decode failed')
+	}
+	if decoded_len != usize(expected_size) {
+		return error('invalid embedded gzip asset: size mismatch')
+	}
+	// Borrow only until bytestr copies the result into its own string storage.
+	decoded := unsafe { data[..int(decoded_len)] }
+	if C.vjsx_embedded_asset_crc32(decoded.data, decoded_len) != expected_crc {
+		return error('invalid embedded gzip asset: crc32 mismatch')
+	}
+	return decoded.bytestr()
+}
diff --git a/runtime_asset_gzip.h b/runtime_asset_gzip.h
new file mode 100644
--- /dev/null
+++ b/runtime_asset_gzip.h
@@ -0,0 +1,26 @@
+#ifndef VJSX_RUNTIME_ASSET_GZIP_H
+#define VJSX_RUNTIME_ASSET_GZIP_H
+
+#define MINIZ_NO_ZLIB_COMPATIBLE_NAMES
+#include "miniz.h"
+
+/* Decode one trusted embedded member into a V-owned buffer. Require exact
+ * input consumption so trailing payload bytes cannot bypass validation. */
+static int vjsx_inflate_embedded_asset(const void *input, size_t input_size,
+                                     void *output, size_t output_capacity,
+                                     size_t *output_size) {
+    tinfl_decompressor decoder;
+    tinfl_init(&decoder);
+    size_t consumed = input_size;
+    size_t produced = output_capacity;
+    tinfl_status status = tinfl_decompress(
+        &decoder, (const mz_uint8 *)input, &consumed,
+        (mz_uint8 *)output, (mz_uint8 *)output, &produced,
+        TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF);
+    *output_size = produced;
+    return status == TINFL_STATUS_DONE && consumed == input_size;
+}
+static mz_uint32 vjsx_embedded_asset_crc32(const void *bytes, size_t size) {
+    return (mz_uint32)mz_crc32(MZ_CRC32_INIT, (const mz_uint8 *)bytes, size);
+}
+#endif
diff --git a/runtime_asset_gzip_test.v b/runtime_asset_gzip_test.v
new file mode 100644
--- /dev/null
+++ b/runtime_asset_gzip_test.v
@@ -0,0 +1,73 @@
+module vjsx
+
+import compress.gzip
+
+fn embedded_gzip_expect_error(data []u8) {
+	if _ := decode_embedded_gzip_asset(data) {
+		assert false
+	}
+}
+
+fn test_embedded_gzip_native_matches_reference_for_compiler_asset() {
+	bytes := runtime_asset_typescript_js_gz.to_bytes()
+	expected := gzip.decompress(bytes) or { panic(err) }
+	actual := runtime_embedded_gzip_asset_source(runtime_asset_typescript_js_gz) or { panic(err) }
+	assert actual.bytes() == expected
+}
+
+fn test_embedded_gzip_native_preserves_empty_and_binary_payloads() {
+	for plain in [[]u8{}, [u8(0), 1, 255, 0, 128], 'text with repeated content'.repeat(100).bytes()] {
+		bytes := gzip.compress(plain) or { panic(err) }
+		actual := decode_embedded_gzip_asset(bytes) or { panic(err) }
+		assert actual.bytes() == plain
+	}
+}
+
+fn test_embedded_gzip_native_rejects_header_payload_crc_and_length_corruption() {
+	valid := gzip.compress('embedded asset'.repeat(32).bytes()) or { panic(err) }
+	embedded_gzip_expect_error([]u8{})
+	embedded_gzip_expect_error(valid[..8])
+	for index in [0, 2, valid.len - 8, valid.len - 4] {
+		mut bad := valid.clone()
+		bad[index] ^= u8(1)
+		embedded_gzip_expect_error(bad)
+	}
+	mut bad_payload := valid.clone()
+	bad_payload[10] = u8(255)
+	embedded_gzip_expect_error(bad_payload)
+}
+
+fn test_embedded_gzip_native_rejects_trailing_payload_and_concatenated_members() {
+	valid := gzip.compress('embedded asset'.bytes()) or { panic(err) }
+	mut extra := valid[..valid.len - 8].clone()
+	extra << u8(0)
+	extra << valid[valid.len - 8..]
+	embedded_gzip_expect_error(extra)
+	mut multiple := valid.clone()
+	multiple << valid
+	embedded_gzip_expect_error(multiple)
+}
+
+fn test_embedded_gzip_native_rejects_oversized_declared_length_before_allocation() {
+	mut bytes := gzip.compress('small'.bytes()) or { panic(err) }
+	for i in bytes.len - 4 .. bytes.len { bytes[i] = u8(255) }
+	embedded_gzip_expect_error(bytes)
+}
+
+fn test_embedded_gzip_native_results_are_owned_and_concurrent() {
+	plain := 'independent owned buffers'.repeat(256)
+	bytes := gzip.compress(plain.bytes()) or { panic(err) }
+	mut tasks := []thread{}
+	for _ in 0 .. 16 {
+		tasks << spawn fn [bytes, plain] () {
+			for _ in 0 .. 16 {
+				result := decode_embedded_gzip_asset(bytes) or { panic(err) }
+				assert result == plain
+			}
+		}()
+	}
+	tasks.wait()
+	first := decode_embedded_gzip_asset(bytes) or { panic(err) }
+	_ := decode_embedded_gzip_asset(bytes) or { panic(err) }
+	assert first == plain
+}
