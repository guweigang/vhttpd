# vhttpd environment variables
# Copy this file to .env and fill in your values, or export them in your shell.

# ── Feishu (飞书) Bot ──
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=xxx

# ── Codex AI Agent ──
CODEX_URL=ws://127.0.0.1:4500

# ── PHP Worker Extension (vslim) ──
# Absolute path to the vslim.so PHP extension; required when using the PHP executor.
# Example on macOS: /Users/you/Source/vphpx/vslim/vslim.so
# Example on Linux:  /home/you/src/vphpx/vslim/vslim.so
VSLIM_EXT=/path/to/vphpx/vslim/vslim.so
