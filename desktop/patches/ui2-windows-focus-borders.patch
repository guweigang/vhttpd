+// Use a solid brand-coloured focus outline instead of Win32's XOR dotted
+// rectangle. Keep focus visible for keyboard users and respect high contrast.
+static inline void ui2_win_paint_focus_outline(HDC dc, const RECT *bounds) {
+	int saved = SaveDC(dc);
+	double scale = GetDeviceCaps(dc, LOGPIXELSX) / 96.0;
+	int inset = (int)(2 * scale + 0.5);
+	RECT rect = *bounds;
+	InflateRect(&rect, -inset, -inset);
+	HIGHCONTRASTW contrast = {sizeof(HIGHCONTRASTW)};
+	COLORREF color = RGB(37,99,235);
+	if (SystemParametersInfoW(SPI_GETHIGHCONTRAST, sizeof(contrast), &contrast, 0)
+			&& (contrast.dwFlags & HCF_HIGHCONTRASTON)) color = GetSysColor(COLOR_HIGHLIGHT);
+	HPEN pen = CreatePen(PS_SOLID, (int)(scale + 0.5), color);
+	SelectObject(dc, pen);
+	SelectObject(dc, GetStockObject(HOLLOW_BRUSH));
+	RoundRect(dc, rect.left, rect.top, rect.right, rect.bottom,
+		(int)(10 * scale + 0.5), (int)(10 * scale + 0.5));
+	RestoreDC(dc, saved);
+	DeleteObject(pen);
+}
+
 static inline void ui2_win_draw_focus_rect(void *hwnd_ptr) {
 	HWND hwnd = (HWND)hwnd_ptr;
 	if (hwnd == NULL || GetFocus() != hwnd) return;
 	RECT rect;
 	if (!GetClientRect(hwnd, &rect)) return;
-	InflateRect(&rect, -3, -3);
 	if (rect.right <= rect.left || rect.bottom <= rect.top) return;
 	HDC dc = GetDC(hwnd);
 	if (dc == NULL) return;
-	DrawFocusRect(dc, &rect);
+	ui2_win_paint_focus_outline(dc, &rect);
 	ReleaseDC(hwnd, dc);
 }
 
