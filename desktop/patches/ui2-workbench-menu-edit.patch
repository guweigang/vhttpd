+// Host menu commands reuse the same editor path as Ctrl+A/X/C/V.
+$if linux && !ui2_headless ? {
+	pub fn workbench_text_has_selection() bool {
+		if editor := g_text_editors[g_focused_field] { return !editor.selection.collapsed() }
