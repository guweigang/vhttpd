+		// Pass all paths/arguments positionally; clipboard text is never shell code.
+		mut arguments := ['/bin/sh', '-c',
+			'input=$1; shift; exec "$@" < "$input" >/dev/null 2>&1',
+			'ui2-clipboard', path]
+		arguments << tool.copy
+		result := os.exec(arguments)
+		return result.exit_code == 0
 	}
 
 	fn native_clipboard_text() ?string {
