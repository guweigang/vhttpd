+fn windows_structure_changed(previous Element, current Element) bool {
+	if previous.id != current.id || previous.key != current.key || previous.kind != current.kind
+		|| previous.hidden != current.hidden || previous.children.len != current.children.len {
+		return true
+	}
+	for i, child in previous.children {
+		if windows_structure_changed(child, current.children[i]) {
+			return true
+		}
+	}
+	return false
+}
+
+fn windows_redraw_region(hwnd voidptr, frame Rect) {
+	C.ui2_win_redraw_region(hwnd, int(frame.x), int(frame.y), int(frame.x + frame.width),
+		int(frame.y + frame.height))
+}
+
+fn windows_redraw_changed_regions(hwnd voidptr, previous Element, current Element) {
+	// Theme changes already invalidate the entire tree in windows_update_root_box.
+	if previous.box != current.box {
+		return
+	}
+	if previous.kind != .screen || current.kind != .screen {
+		if windows_structure_changed(previous, current) {
+			windows_redraw_region(hwnd, previous.frame)
+			windows_redraw_region(hwnd, current.frame)
+		}
+		return
+	}
+	// A replaced page can expose previously covered pixels. Repaint its old
+	// and new client rectangles after native layout, leaving the sidebar alone.
+	for i, child in previous.children {
+		if i >= current.children.len {
+			windows_redraw_region(hwnd, child.frame)
+		} else if windows_structure_changed(child, current.children[i]) {
+			windows_redraw_region(hwnd, child.frame)
+			if child.frame != current.children[i].frame {
+				windows_redraw_region(hwnd, current.children[i].frame)
+			}
+		}
+	}
+	for i in previous.children.len .. current.children.len {
+		windows_redraw_region(hwnd, current.children[i].frame)
+	}
+}
