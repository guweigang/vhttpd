+fn windows_load_image(hwnd voidptr, path string, frame Rect) !voidptr {
+	if path.to_lower().ends_with('.png') {
+		// Use V's file APIs so that Windows paths with Unicode characters work.
+		data := os.read_bytes(path)!
+		decoded := stbi.load_from_memory(data.data, data.len, desired_channels: 4)!
+		defer { decoded.free() }
+		bitmap := C.ui2_win_set_alpha_bitmap(hwnd, decoded.data, decoded.width, decoded.height)
+		if bitmap == unsafe { nil } {
+			return error('could not create an alpha bitmap for ${path}')
+		}
+		return bitmap
+	}
+	wide_path := path.to_wide()
+	defer { unsafe { free(wide_path) } }
+	bitmap := C.ui2_win_set_bitmap(hwnd, wide_path, int(frame.width), int(frame.height))
+	if bitmap == unsafe { nil } && path != '' {
+		return error('could not load Windows bitmap: ${path}')
+	}
+	return bitmap
 }
 
